# GISSUF AI Avatar — Environment Configuration
# Copy this file to .env and insert your API keys if you want to use a live AI model.
# If left blank, GISSUF AI Avatar runs seamlessly in offline Demonstration Mode!

# Option 1: Google Gemini (Recommended for free tier / fast response)
# GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: OpenAI API
# OPENAI_API_KEY=your_openai_api_key_here

# Option 3: Groq Cloud (Ultra-fast open source models)
# GROQ_API_KEY=your_groq_api_key_here

# Server Port (Default: 8000)
PORT=8000
